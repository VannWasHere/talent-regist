# =============================================================================
# Copy file ini jadi `.env.local` (untuk lokal) dan isi nilainya.
# Di Vercel: Project → Settings → Environment Variables.
# Yang WAJIB di Vercel cuma 4 variabel di bagian A dan B.
# =============================================================================

# --- A. Supabase: dipakai aplikasi (WAJIB) -----------------------------------
# Ambil di Supabase Dashboard → Project Settings → API.
#
# 1) Project URL. Format https://xxxxxxxxxxxx.supabase.co (TANPA slash akhir)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
#
# 2) service_role secret key. Dipakai HANYA di server (route handler & halaman
#    admin), tidak pernah dikirim ke browser. JANGAN pakai anon/publishable key,
#    dan jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- B. Admin (WAJIB) -------------------------------------------------------
# Password untuk membuka halaman /admin.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Secret untuk menandatangani cookie sesi admin (minimal 16 karakter).
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- C. Koneksi database langsung (opsional, hanya untuk setup) -------------
# TIDAK dipakai aplikasi saat runtime, dan TIDAK perlu diisi di Vercel.
# Hanya dibutuhkan kalau kamu menjalankan `node scripts/setup-db.mjs` untuk
# membuat / memperbarui tabel dari terminal.
#
# Nama database di Supabase selalu `postgres` (nama project kamu beda hal).
SUPABASE_DB_NAME=postgres
#
# Password database. Ambil / reset di Supabase → Project Settings → Database.
# Ini BUKAN service role key dan BUKAN ADMIN_PASSWORD.
SUPABASE_DB_PASSWORD=

# --- D. Opsional ------------------------------------------------------------
# Ganti nama tabel kalau kamu tidak memakai default.
# SUPABASE_TABLE=talent_registrations
