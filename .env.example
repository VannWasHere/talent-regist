# --- Wajib ---------------------------------------------------------------
# Password untuk membuka halaman /admin.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Secret untuk enkripsi data pendaftar + tanda tangan cookie admin.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PENTING: kalau nilai ini diganti, data pendaftar lama tidak bisa dibaca lagi.
APP_SECRET=

# --- Otomatis dari Vercel ------------------------------------------------
# Muncul sendiri setelah Blob store dihubungkan ke project.
# Kalau kosong, aplikasi jalan pakai penyimpanan lokal (.data/) dan
# upload file video dimatikan (peserta cuma bisa kirim link).
BLOB_READ_WRITE_TOKEN=

# --- Opsional ------------------------------------------------------------
# Batas ukuran upload video (MB). Default 100.
MAX_VIDEO_MB=100
